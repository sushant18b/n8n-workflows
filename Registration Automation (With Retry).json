        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"code\": \"export default async ({ page }) => {\\n  try {\\n    const email = '{{ $('Generate Session ID1').item.json.email }}';\\n    const password = '{{ $('Generate Session ID1').item.json.password }}';\\n\\n    await page.goto('https://propinspection.com/auth1', {\\n      waitUntil: 'networkidle2',\\n      timeout: 30000\\n    });\\n\\n    await new Promise(resolve => setTimeout(resolve, 3000));\\n\\n    const emailInput = await page.$('input[name=\\\"email\\\"]');\\n    if (!emailInput) {\\n      throw new Error('Email input not found');\\n    }\\n\\n    await emailInput.click();\\n    await emailInput.type(email);\\n\\n    await page.keyboard.press('Tab');\\n    await new Promise(resolve => setTimeout(resolve, 500));\\n\\n    await page.keyboard.type(password);\\n\\n    await page.keyboard.press('Tab');\\n    await new Promise(resolve => setTimeout(resolve, 300));\\n\\n    await page.keyboard.press('Enter');\\n\\n    await new Promise(resolve => setTimeout(resolve, 5000));\\n\\n    const finalUrl = page.url();\\n\\n    if (finalUrl.includes('/auth1')) {\\n      return {\\n        success: false,\\n        error: 'Login did not redirect. Credentials may be invalid or Sign In was not activated.',\\n        finalUrl\\n      };\\n    }\\n\\n    return {\\n      success: true,\\n      finalUrl\\n    };\\n\\n  } catch (error) {\\n    return {\\n      success: false,\\n      error: error.message,\\n      finalUrl: page.url()\\n    };\\n  }\\n};\"\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 45000
        }
